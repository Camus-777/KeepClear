<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><AssemblyName>KeepClear</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion><PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><OutputPath>dist\</OutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\KeepClear.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Drawing"/><Reference Include="System.Windows.Forms"/><Reference Include="System.Xml"/><Reference Include="System.IO.Compression"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="drivers\VBCABLE_Driver_Pack46.zip"><LogicalName>KeepClear.VBCable.zip</LogicalName></EmbeddedResource></ItemGroup>
  <ItemGroup><Compile Include="src\*.cs"/></ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
</Project>
